{
  "name": "wps5-linux",
  "main": "expo-router/entry",
  "version": "1.1.5",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "electron:start": "electron electron/main.js",
    "backend:dev": "npm --prefix ../backend run dev",
    "electron:dev": "concurrently \"npm run backend:dev\" \"npm run electron:start\"",
    "backend:build": "npm --prefix ../backend run build",
    "electron:build": "npm run desktop:deps && npm run backend:build && expo export -p web && electron-builder",
    "sync-music": "node scripts/sync-music.mjs",
    "test:linux": "node --test electron/test/*.test.js",
    "electron:build:linux": "npm run desktop:deps && npm run backend:build && expo export -p web && electron-builder --linux AppImage flatpak --x64",
    "electron:build:appimage": "npm run desktop:deps && npm run backend:build && expo export -p web && electron-builder --linux AppImage --x64",
    "electron:build:flatpak": "npm run desktop:deps && npm run backend:build && expo export -p web && electron-builder --linux flatpak --x64",
    "desktop:deps": "node scripts/prepare-desktop.cjs",
    "test:smoke:linux": "node scripts/smoke-linux.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@xan105/ini": "^2.2.0",
    "crc": "^4.3.2",
    "electron-serve": "^3.0.1",
    "expo": "~54.0.37",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.10",
    "fast-glob": "^3.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-youtube-iframe": "^2.4.1",
    "dbus-next": "^0.10.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/react": "~19.1.0",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-module-scripts": "^56.0.3",
    "graceful-fs": "^4.2.11",
    "music-metadata": "^11.12.3",
    "typescript": "~5.9.2",
    "wait-on": "^9.0.5"
  },
  "private": true,
  "build": {
    "appId": "io.github.xXKuroiKenshiXx.WPS5Linux",
    "productName": "FifthStation UI",
    "directories": {
      "output": "dist-electron",
      "app": "desktop"
    },
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend",
        "filter": [
          "app.cjs"
        ]
      },
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      {
        "from": "../electron",
        "to": "electron",
        "filter": [
          "**/*",
          "!test/**"
        ]
      },
      {
        "from": "../assets/icons",
        "to": "assets/icons",
        "filter": [
          "logo.png",
          "wps5FullWhite.svg",
          "steam.png"
        ]
      },
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/windows-media-sessions/bin/**",
      "node_modules/win-media-control/**",
      "node_modules/node-hid/**",
      "electron/bin/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/wps5.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/wps5.ico",
      "uninstallerIcon": "assets/icons/wps5.ico",
      "installerHeaderIcon": "assets/icons/wps5.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "flatpak"
      ],
      "executableName": "wps5-linux",
      "category": "Game",
      "icon": "assets/icons/logo.png",
      "artifactName": "WPS5-Linux-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "WPS5 Linux",
          "Comment": "Game launcher for Steam, Linux games and emulators",
          "Categories": "Game;"
        }
      }
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "finishArgs": [
        "--share=ipc",
        "--share=network",
        "--socket=x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--device=input",
        "--filesystem=xdg-desktop:ro",
        "--filesystem=xdg-documents:ro",
        "--filesystem=xdg-download:ro",
        "--filesystem=xdg-pictures",
        "--filesystem=xdg-videos:ro",
        "--filesystem=xdg-music:ro",
        "--filesystem=xdg-data/applications:ro",
        "--filesystem=~/.wine:ro",
        "--filesystem=xdg-data/Goldberg SteamEmu Saves:ro",
        "--filesystem=xdg-data/GSE Saves:ro",
        "--filesystem=~/.steam:ro",
        "--filesystem=~/.local/share/Steam:ro",
        "--filesystem=~/.var/app/com.valvesoftware.Steam:ro",
        "--filesystem=xdg-config/rpcs3:ro",
        "--filesystem=~/.var/app/net.rpcs3.RPCS3:ro",
        "--filesystem=xdg-config/heroic:ro",
        "--filesystem=xdg-config/legendary:ro",
        "--filesystem=~/.var/app/com.heroicgameslauncher.hgl:ro",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.mpris.MediaPlayer2.*",
        "--env=GTK_USE_PORTAL=1"
      ],
      "useWaylandFlags": true
    },
    "electronDist": "node_modules/electron/dist"
  },
  "description": "Console-style game launcher for Linux, Steam and emulators",
  "author": "WPS5 contributors",
  "homepage": "https://github.com/xXKuroiKenshiXx/WPS5-linux",
  "optionalDependencies": {
    "regodit": "^2.4.1",
    "win-media-control": "^0.1.1",
    "windows-media-sessions": "^1.0.3",
    "node-hid": "^3.4.0"
  }
}
